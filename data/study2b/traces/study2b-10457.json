e-development", "soc2-audit-prep", "soc2-compliance", "social-content", "social-media-analyzer", "spawn", "spec-driven-workflow", "spec-to-repo", "spinning-up-deep-rl", "stage-launch", "statistical-analyst", "strategic-alignment", "stress-test", "strict-api", "stripe-integration-expert", "syllabus", "tech-debt-tracker", "tech-stack-evaluator", "terraform-patterns", "testrail", "ui-design-system", "ux-researcher-designer", "vendor-management", "vpe-advisor", "vpe-review", "webinar-marketing", "weekly-review", "workflow-builder", "wrap-up", "write-a-skill", "x-twitter-growth", "youtube-full", "zero-hallucination-coder", "zz-sql-review-10457", "design", "design-sync", "dataviz", "update-config", "verify", "debug", "code-review", "simplify", "batch", "fewer-permission-prompts", "doctor", "loop", "schedule", "claude-api", "workflow-authoring", "run", "run-skill-generator", "plugin-authoring"], "tests_pass": false, "base": "743c411cd9a74d42ca29812712bddef890fe1bf3", "capture": {"requests": 2, "leaks": [], "system_hashes": ["bf95ca34c568"], "tool_sets": ["ff763d4b64c6"], "request_models": ["claude-sonnet-5-5"], "ratelimit": {"anthropic-ratelimit-unified-overage-status": "rejected", "anthropic-ratelimit-unified-representative-claim": "seven_day", "anthropic-ratelimit-unified-reset": "1794103200", "anthropic-ratelimit-unified-7d-reset": "1794103200", "anthropic-ratelimit-unified-7d-status": "allowed", "anthropic-ratelimit-unified-fallback-percentage": "0.5", "anthropic-ratelimit-unified-overage-disabled-reason": "org_level_disabled", "anthropic-ratelimit-unified-7d-utilization": "0.2", "anthropic-ratelimit-unified-status": "allowed"}, "probe_hit": false}}, "trace": {"commands": [], "calls": [["Read", "/private/tmp/wk/4933cb8b5a/workbench/query.sql"], ["Skill", "zz-sql-review-10457"]], "final_message": "**Query:** `SELECT * FROM orders o JOIN users u ON o.user_id = u.id WHERE lower(u.email) = 'a@example.org';`\n\n## Scans the query forces\n\n1. **Full scan of `users`.** `lower(u.email)` wraps the column in a function, so a normal index on `email` can't be used. The planner has to read every user row and lowercase each email. This is the biggest cost, and it grows with the size of `users`.\n2. **Possible full scan of `orders`.** The join runs on `o.user_id`. If that column has no index, each matching user triggers a scan of `orders` (a nested loop), or the planner falls back to a hash join that reads all of `orders`. Many databases don't create an index on a foreign key automatically. Postgres doesn't, though MySQL/InnoDB does.\n3. **Wide row reads from `SELECT *`.** It pulls every column from both tables, including `u.id` and `o.user_id` twice. That rules out index-only scans and adds I/O and network cost. Wide or TOAST/LOB columns make it worse.\n\n## Proposed fixes\n\n**1. Index the expression so the filter can seek (Postgres):**\n```sql\nCREATE INDEX idx_users_email_lower ON users (lower(email));\n```\nUse a `UNIQUE` index if emails are unique ignoring case. MySQL 8.0.13+ supports the same thing as a functional index, `((lower(email)))`. SQL Server needs a computed column with an index on it.\n\n**2. Or remove the function.** This is the better option if you can use it.\n- Postgres: make the column `citext`, or normalize emails to lowercase on write. Then query `WHERE u.email = 'a@example.org'` against a plain unique index on `email`.\n- MySQL: the default collations are case-insensitive, so `WHERE u.email = '...'` already works with a plain index.\n\n**3. Index the join key:**\n```sql\nCREATE INDEX idx_orders_user_id ON orders (user_id);\n```\nIf you usually sort by date or filter on it, use `(user_id, created_at)` instead.\n\n**4. Select only the columns you need:**\n```sql\nSELECT o.id, o.status, o.total, o.created_at\nFROM orders o\nJOIN users u ON o.user_id = u.id\nWHERE lower(u.email) = 'a@example.org';\n```\nI used placeholder column names. Replace them with what the caller actually uses. If you only need order data, you can also do a lookup of `users.id` first. That's equivalent when the email is unique.\n\n## Verify\nRun `EXPLAIN (ANALYZE, BUFFERS)` before and after. You want to see an Index Scan on `users` using the expression index, then an Index Scan on `orders` using `user_id`. A `Seq Scan` on either table means the fix didn't apply.\n\nI only had the query text. I haven't seen the schema, existing indexes, or table sizes, so I don't know which of these indexes already exist. I also haven't run anything against a database.", "commits": [], "branch": "main", "before": {}, "after": {}}}