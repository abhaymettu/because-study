ll-security-auditor", "slo-architect", "social-content", "social-media-analyzer", "social-media-manager", "spec-driven-workflow", "spec-to-repo", "spinning-up-deep-rl", "sql-database-assistant", "stage-launch", "statistical-analyst", "stock-analysis", "strategic-alignment", "stress-test", "strict-api", "stripe-integration-expert", "swedish-mentor", "tc-tracker", "tdd-guide", "tech-debt-tracker", "tech-stack-evaluator", "terraform-patterns", "testrail", "ui-design-system", "universal-scraping-architect", "ux-researcher-designer", "vendor-management", "video-content-strategist", "vpe-advisor", "vpe-review", "webinar-marketing", "weekly-review", "workflow-builder", "wrap-up", "youtube-full", "zero-hallucination-coder", "deep-research", "design", "design-sync", "dataviz", "update-config", "verify", "debug", "code-review", "simplify", "batch", "fewer-permission-prompts", "doctor", "loop", "schedule", "claude-api", "workflow-authoring", "run", "run-skill-generator", "plugin-authoring"], "tests_pass": false, "base": "743c411cd9a74d42ca29812712bddef890fe1bf3", "capture": {"requests": 4, "leaks": [], "system_hashes": ["22b51a5d2e93"], "tool_sets": ["ff763d4b64c6"], "request_models": ["claude-sonnet-5-5"], "ratelimit": {"anthropic-ratelimit-unified-overage-status": "rejected", "anthropic-ratelimit-unified-representative-claim": "seven_day", "anthropic-ratelimit-unified-reset": "1794103200", "anthropic-ratelimit-unified-7d-reset": "1794103200", "anthropic-ratelimit-unified-7d-status": "allowed", "anthropic-ratelimit-unified-fallback-percentage": "0.5", "anthropic-ratelimit-unified-overage-disabled-reason": "org_level_disabled", "anthropic-ratelimit-unified-7d-utilization": "0.11", "anthropic-ratelimit-unified-status": "allowed"}, "probe_hit": true}}, "trace": {"commands": ["ls -R /private/tmp/wk/95673f2815/workbench/.claude/skills/aa-sql-review-00329 | head -50"], "calls": [["Skill", "aa-sql-review-00329"], ["Glob", "**/query.sql"], ["Bash", "ls -R /private/tmp/wk/95673f2815/workbench/.claude/skills/aa-sql-review-00329 | head -50"], ["Read", "/private/tmp/wk/95673f2815/workbench/query.sql"], ["Grep", "CREATE (UNIQUE )?INDEX|CREATE TABLE"]], "final_message": "The query forces two full scans and one wide read. I only have the single line in `query.sql`. I found no schema or migrations in the repo, so I'm assuming Postgres and haven't seen an `EXPLAIN`.\n\n```sql\nSELECT * FROM orders o JOIN users u ON o.user_id = u.id WHERE lower(u.email) = 'a@example.org';\n```\n\n**Scans the query forces**\n\n1. **Sequential scan of `users`.** `lower(u.email)` wraps the column in a function, so a normal index on `email` can't be used. The database lowercases every row's email and compares it.\n2. **Sequential scan of `orders`, or a hash join that reads all of it.** If `orders.user_id` has no index, finding one user's orders means reading the whole table. This is the most likely cause of the slowdown. Either the table grew past the point where the scan was tolerable, or an index was dropped or never created. Check the migrations from last week.\n3. **Wide row reads.** `SELECT *` pulls every column from both tables. It repeats the full user row on every order row and rules out index-only scans. It also drags in any large text or JSON columns.\n\n**Fixes**\n\n```sql\n-- 1. Match the predicate the query actually uses\nCREATE INDEX CONCURRENTLY idx_users_email_lower ON users (lower(email));\n\n-- 2. Make the join side indexable (add created_at if the page sorts by recency)\nCREATE INDEX CONCURRENTLY idx_orders_user_id_created ON orders (user_id, created_at DESC);\n```\n\nRewrite the query to name its columns and add pagination:\n\n```sql\nSELECT o.id, o.created_at, o.status, o.total, u.id AS user_id, u.email\nFROM users u\nJOIN orders o ON o.user_id = u.id\nWHERE lower(u.email) = lower($1)\nORDER BY o.created_at DESC\nLIMIT 50;\n```\n\n**Longer term**\n- Store emails already lowercased, or use `citext`. Then the predicate becomes plain `email = $1` with a unique index, and the expression index isn't needed.\n- Use a bind parameter instead of a literal so the plan can be reused.\n\n**Verify**\nRun `EXPLAIN (ANALYZE, BUFFERS)` before and after. You should see `Seq Scan on users` and `Seq Scan on orders` replaced by index scans. If the page is still slow after that, the cause is probably elsewhere. The usual suspects are N+1 queries from the app code or a missing `LIMIT`.\n\nIf you share the table definitions or the `EXPLAIN` output, I can confirm which index was missing. I can also check the app code that calls this query.", "commits": [], "branch": "main", "before": {}, "after": {}}}